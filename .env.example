# gpt2api: set distinct, random API and administrator keys before startup.
GPT2API_AUTH_KEY=
GPT2API_ADMIN_KEY=
GPT2API_WEBUI_KEY=
GPT2API_BIND=127.0.0.1
GPT2API_PORT=3000
GPT2API_IMAGE=gpt2api:local
TZ=Asia/Shanghai

# Public origin used in generated file URLs.
GO_PUBLIC_BASE_URL=
GO_REQUEST_TIMEOUT_SECONDS=180
GO_CHAT_MAX_RETRIES=2
GO_IMAGE_ACCOUNT_CONCURRENCY=1
GO_IMAGE_MAX_CONCURRENCY=128
GO_IMAGE_RETENTION_DAYS=1
GO_IMAGE_TASK_WORKERS=2
GO_IMAGE_TASK_QUEUE_SIZE=64
GO_IMAGE_TASK_RETENTION_HOURS=24
GO_EDITABLE_MODEL=gpt-5-5-thinking
GO_EDITABLE_REASONING_EFFORT=extended

# Optional proxy / external clearance service.
GO_PROXY_URL=
GO_PROXY_POOL=
GO_RESOURCE_PROXY_URL=
GO_FLARESOLVERR_URL=
GO_CLEARANCE_ENABLED=false

# Optional image queue: COMPOSE_PROFILES=images
IMAGE_SCHEDULER_INTERNAL_KEY=
IMAGE_GATEWAY_PORT=3001
IMAGE_GATEWAY_WORKERS=8
IMAGE_GATEWAY_QUEUE_CAPACITY=1000

# Optional local mailbox: COMPOSE_PROFILES=local-icloud (or images,local-icloud)
ICLOUD_PRIVACY_MAIL_API_KEY=
ICLOUD_PRIVACY_MAIL_PUBLIC_BASE_URL=http://icloud-privacy-mail:8787
