[Unit]
Description=gpt2api
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__APP_DIR__
Environment=GO_LISTEN_ADDR=127.0.0.1:8000
EnvironmentFile=-__APP_DIR__/.env
ExecStart=__APP_DIR__/bin/gpt2api
Restart=on-failure
RestartSec=3
TimeoutStopSec=120
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
